    <Component class="javax.swing.JCheckBox" name="chkMitm">
      <Properties>
        <Property name="text" type="java.lang.String" value="Bật giải mã HTTPS (cần cài chứng chỉ gốc vào máy khách; áp dụng khi bật lại proxy)"/>
      </Properties>
    </Component>
    <Container class="javax.swing.JScrollPane" name="jScrollPane1">
      <AuxValues>
        <AuxValue name="autoScrollPane" type="java.lang.Boolean" value="true"/>
      </AuxValues>

      <Layout class="org.netbeans.modules.form.compat2.layouts.support.JScrollPaneSupportLayout"/>
      <SubComponents>
        <Component class="javax.swing.JTextArea" name="txtInfo">
      <Properties>
        <Property name="columns" type="int" value="20"/>
        <Property name="rows" type="int" value="5"/>
        <Property name="editable" type="boolean" value="false"/>
        <Property name="lineWrap" type="boolean" value="true"/>
        <Property name="wrapStyleWord" type="boolean" value="true"/>
        <Property name="text" type="java.lang.String" value="Giải mã HTTPS cho phép proxy thấy địa chỉ đầy đủ (đường dẫn, từ khóa) của trang HTTPS để ghi nhật ký và chặn theo quy tắc. CHỈ dùng trên thiết bị của chính bạn hoặc khi người dùng đã đồng ý. Cách làm: (1) Bấm &quot;Tạo / xuất chứng chỉ gốc&quot; để có file proxy-ca.crt. (2) Windows (Chrome, Edge): bấm đúp file, chọn Install Certificate &gt; Current User &gt; Place all certificates in the following store &gt; Browse &gt; Trusted Root Certification Authorities &gt; Next &gt; Finish &gt; Yes. (3) Firefox có kho riêng: Settings &gt; Privacy &amp; Security &gt; View Certificates &gt; Authorities &gt; Import, tick Trust this CA to identify websites. (4) Điện thoại hoặc máy khác: gửi file proxy-ca.crt sang và cài làm chứng chỉ CA, Android và iOS còn phải bật tin cậy trong cài đặt. (5) Tick ô ở trên, bấm Lưu, rồi tắt và bật lại proxy. (6) Muốn gỡ: chạy certmgr.msc, mở Trusted Root Certification Authorities &gt; Certificates, xóa dòng ProxyApp Local CA. Khóa riêng của CA nằm trong file proxy-ca.p12: giữ kín, ai có file này có thể giả mạo mọi trang trên máy đã cài chứng chỉ. Ngân hàng, ví điện tử và ứng dụng ghim chứng chỉ nên thêm vào danh sách bên dưới để không bị giải mã."/>
      </Properties>
        </Component>
      </SubComponents>
    </Container>
