      <SubComponents>
        <Component class="javax.swing.JTextArea" name="txtRulesHelp">
      <Properties>
        <Property name="columns" type="int" value="20"/>
        <Property name="rows" type="int" value="5"/>
        <Property name="editable" type="boolean" value="false"/>
        <Property name="lineWrap" type="boolean" value="true"/>
        <Property name="wrapStyleWord" type="boolean" value="true"/>
        <Property name="text" type="java.lang.String" value="Mỗi dòng: tên miền, loại, giá trị. Loại path: chặn khi đường dẫn bắt đầu bằng giá trị, ví dụ youtube.com path /shorts. Loại keyword: chặn khi tên miền + đường dẫn có chứa từ khóa, ví dụ * keyword casino (dấu * là mọi trang). Với HTTPS chỉ thấy đường dẫn khi đã bật giải mã và trang không nằm trong danh sách không giải mã; nếu không thì chỉ so từ khóa với tên miền. Quy tắc và danh sách không giải mã áp dụng ngay khi lưu."/>
      </Properties>
        </Component>
      </SubComponents>
